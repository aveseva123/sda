# Порт HTTP-сервера и каталог для базы данных (SQLite)
PORT=8090
DATA_DIR=./data

# Публичный адрес сервиса (нужен для вебхуков Telegram/WhatsApp и ссылок в сообщениях)
PUBLIC_URL=https://notify.example.ru

# Токен администратора: вход в панель и доступ к /admin/* (обязателен)
ADMIN_TOKEN=change-me-admin

# Токен для внешнего API отправки (/api/v1/*). Если не задан — используется ADMIN_TOKEN
API_TOKEN=change-me-api

# YCLIENTS: токен партнёра из https://yclients.ru/appstore/developers → Настройки аккаунта
# Логин/пароль пользователя YCLIENTS с доступом к журналу записи. Остальное можно задать в панели.
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_LOGIN=
YCLIENTS_PASSWORD=
YCLIENTS_USER_TOKEN=
YCLIENTS_COMPANY_ID=

# Telegram-бот (создать через @BotFather)
TELEGRAM_BOT_TOKEN=
# WhatsApp Cloud API (Meta): id номера и постоянный токен; verify-токен задаётся в настройках приложения Meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# SMS через HTTP-шлюз: пресет smsc | smsru | custom (см. README)
SMS_PROVIDER=
SMS_LOGIN=
SMS_PASSWORD=
SMS_SENDER=
