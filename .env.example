# Настройки боевого запуска. Скопируйте в .env — «Запустить Нестор.bat»
# сделает это сам при первом запуске.

POSTGRES_USER=sda
# ОБЯЗАТЕЛЬНО смените перед боем, особенно если открываете базу наружу.
POSTGRES_PASSWORD=sda
POSTGRES_DB=sda
POSTGRES_PORT=5432
# База и API видны только с самого сервера. 0.0.0.0 откроет их всей сети.
POSTGRES_BIND=127.0.0.1
API_BIND=127.0.0.1
API_PORT=8000

# Порт, по которому в платформу заходят из цеха.
WEB_PORT=8080
VITE_API_BASE=/api
