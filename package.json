{
  "name": "sda-part-measure",
  "version": "0.1.0",
  "private": true,
  "description": "PWA: замер плоских листовых деталей по фото с телефона (ArUco + OpenCV.js), сверка с раскроем DXF, реестр остатков",
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
