    "gen:icons": "node tools/gen-icons.mjs",
    "gen:target": "node tools/gen-target.mjs",
    "sw:manifest": "node tools/gen-sw-manifest.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
