# Auto detect text files and perform LF normalization
* text=auto

# Эталонные DXF заказчика и управляющие программы хранятся байт-в-байт:
# нормализация переводов строк ломает сверку с эталоном, а стойка станка
# требует именно CRLF.
*.dxf -text
*.nc -text
*.tap -text

# Батники Windows обязаны быть с CRLF: с LF cmd спотыкается на них.
*.bat text eol=crlf
